<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Otimização V10</title>

<script src="https://cdn.tailwindcss.com"></script>

<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Rajdhani:wght@500;700&display=swap');

:root{
    --primary-red:#ff0000;
    --bg-black:#050505;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:var(--bg-black);
    color:#fff;
    font-family:'Rajdhani',sans-serif;
    user-select:none;
    -webkit-tap-highlight-color:transparent;
    overflow:hidden;
}

.font-orbitron{
    font-family:'Orbitron',sans-serif;
}

.red-glow{
    box-shadow:0 0 20px rgba(255,0,0,.2);
    border:1px solid rgba(255,0,0,.4);
}

.btn-active:active{
    transform:scale(.95);
}

.scanline{
    width:100%;
    height:2px;
    background:rgba(255,0,0,.1);
    position:absolute;
    animation:move 4s linear infinite;
    pointer-events:none;
}

@keyframes move{
    0%{top:0;}
    100%{top:100%;}
}

.switch-input:checked + .switch-label{
    background-color:var(--primary-red);
}

.switch-input:checked + .switch-label::after{
    transform:translateX(24px);
}
</style>
</head>

<body>

<div class="scanline"></div>

<div id="login-screen" class="fixed inset-0 z-[100] bg-black flex items-center justify-center p-6">
    <div class="w-full max-w-sm p-8 rounded-2xl bg-zinc-950 red-glow text-center">

        <div class="mb-6">
            <div class="w-20 h-20 bg-red-600 rounded-full mx-auto flex items-center justify-center mb-4">
                ⚡
            </div>

            <h1 class="font-orbitron text-2xl font-bold tracking-tighter text-red-600">
                V10 DO IVAN
            </h1>

            <p class="text-zinc-500 text-xs uppercase tracking-widest">
                Painel de Otimização Real
            </p>
        </div>

        <div class="space-y-4">
            <input
                type="text"
                id="user-input"
                placeholder="NOME DE USUÁRIO"
                class="w-full bg-zinc-900 border border-zinc-800 p-3 rounded-lg text-white"
            >

            <input
                type="password"
                id="pass-input"
                placeholder="SENHA"
                class="w-full bg-zinc-900 border border-zinc-800 p-3 rounded-lg text-white"
            >

            <button
                onclick="auth()"
                class="w-full bg-red-600 text-white font-bold py-4 rounded-lg font-orbitron"
            >
                ACESSAR SISTEMA
            </button>
        </div>

        <p id="auth-msg" class="text-red-500 text-xs mt-4 font-bold h-4"></p>
    </div>
</div>

<div id="app-screen" class="hidden h-screen flex flex-col">

<header class="p-4 border-b border-red-900/30 flex justify-between items-center bg-zinc-950">
    <div>
        <h2 class="font-orbitron text-lg font-bold text-red-600">
            V10 DO IVAN
        </h2>

        <span class="text-[10px] text-zinc-500 font-bold uppercase">
            Status:
            <span class="text-green-500">Otimizando</span>
        </span>
    </div>
</header>

<main class="flex-1 overflow-y-auto p-4 space-y-4">

<div class="bg-zinc-900/50 p-4 rounded-xl border border-zinc-800">
    <p class="text-[10px] text-zinc-500 font-bold uppercase mb-1">
        Desempenho da CPU
    </p>

    <div class="flex items-baseline justify-between">
        <span id="cpu-usage" class="text-2xl font-bold text-red-600">
            0%
        </span>

        <span id="cpu-hz" class="text-xs text-zinc-400 font-mono">
            0.00 GHz
        </span>
    </div>

    <div class="w-full h-1 bg-zinc-800 mt-2 rounded-full overflow-hidden">
        <div
            id="cpu-load"
            class="h-full bg-red-600 transition-all duration-500"
            style="width:0%"
        ></div>
    </div>
</div>

<div class="bg-black border border-zinc-900 rounded-xl p-4 font-mono text-[9px] h-32 overflow-y-auto" id="console">
    <p class="text-zinc-600 italic">
        >> Aguardando inicialização...
    </p>
</div>

</main>

<footer class="p-4 bg-zinc-950 text-center">
    <button
        onclick="forceClean()"
        class="w-full bg-zinc-900 border border-red-600/30 text-red-600 font-bold py-3 rounded-xl text-xs font-orbitron"
    >
        LIMPEZA PROFUNDA
    </button>
</footer>

</div>

<script>
let baseTemp = 38;
let targetMaxHz = 3.20;

function say(text){
    if("speechSynthesis" in window){
        window.speechSynthesis.cancel();

        const msg = new SpeechSynthesisUtterance(text);

        msg.lang = "pt-BR";
        msg.rate = 1.1;

        window.speechSynthesis.speak(msg);
    }
}

function auth(){
    const user = document.getElementById("user-input")
        .value
        .toLowerCase()
        .trim();

    const pass = document.getElementById("pass-input")
        .value
        .trim();

    const msg = document.getElementById("auth-msg");

    if(user === "admin ivan" && pass === "2026"){

        say("Bem vindo ao painel");

        document
            .getElementById("login-screen")
            .classList
            .add("hidden");

        document
            .getElementById("app-screen")
            .classList
            .remove("hidden");

        initApp();

    }else{

        say("Login incorreto");

        msg.textContent = "ACESSO NEGADO";

        setTimeout(()=>{
            msg.textContent = "";
        },3000);
    }
}

function initApp(){

    log("Sistema iniciado");

    setInterval(()=>{
        updateHardwareStats();
    },1000);
}

function updateHardwareStats(){

    const cpuUsage =
        Math.floor(Math.random()*80)+10;

    document.getElementById("cpu-usage")
        .textContent = cpuUsage + "%";

    document.getElementById("cpu-load")
        .style.width = cpuUsage + "%";

    const currentHz =
        ((cpuUsage / 100) * (targetMaxHz - 1.2) + 1.2)
        .toFixed(2);

    document.getElementById("cpu-hz")
        .textContent = currentHz + " GHz";
}

function log(text){

    const consoleEl =
        document.getElementById("console");

    const p = document.createElement("p");

    p.className = "text-red-500/80 mb-1";

    p.textContent =
        "[V10] " +
        new Date().toLocaleTimeString() +
        " >> " +
        text;

    consoleEl.prepend(p);
}

function forceClean(){

    log("RAM otimizada com sucesso");

    say("Memória RAM liberada");
}
</script>

</body>
</html>
